# ============================================================================
#  文本统一按 LF 存：这些文件会被 PowerShell / Python / Node 交叉读写，
#  CRLF 混入会在 diff 里制造噪音。
#
#  ⚠️ 与 .gitignore 一样，属性行不支持行尾注释，注释必须单独成行。
# ============================================================================
* text=auto eol=lf

*.js      text eol=lf
*.mjs     text eol=lf
*.json    text eol=lf
*.py      text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
*.cs      text eol=lf
*.java    text eol=lf
*.xml     text eol=lf
*.html    text eol=lf
*.css     text eol=lf

# PowerShell 脚本保存为「UTF-8 with BOM」：
# tools/test_launcher_port.ps1 的读取逻辑依赖 BOM，否则中文提示会乱码。
*.ps1     text eol=crlf

# Windows 启动脚本：cmd 需要 CRLF
*.bat     text eol=crlf
*.cmd     text eol=crlf

# ------------------------------------------------------------------ 二进制
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.mp3     binary
*.mp4     binary
*.zip     binary
*.apk     binary
*.so      binary
*.dex     binary
*.eab     binary
*.jar     binary
*.pk8     binary

# ------------------------------------------------------------------ 语言统计
# 只有「我们自己写的代码」才应该出现在 GitHub 的语言栏里。
# 所以三类都不计入：纯文档、机器生成/从客户端解出的数据、别人写的（客户端与第三方库）。
# 想复核效果：python work/tools/lang_stats.py .

# 纯文档：规格、笔记、说明
docs/**                          linguist-documentation
work/spec/**                     linguist-documentation
work/notes/**                    linguist-documentation

# 机器生成 / 解包出来的数据（不算手写代码）
work/spec/_dumps/**              linguist-generated -linguist-documentation
work/spec/data/**                linguist-generated -linguist-documentation
work/run/engine/data/**          linguist-generated
work/run/web/__offline-engine.js linguist-generated
work/run/web/version.json        linguist-generated
work/*.json                      linguist-generated
work/probe/*.json                linguist-generated

# 别人写的：客户端本体 JS、其第三方库、原版代码副本
work/run/web/js/**               linguist-vendored
work/run/web/resource/**         linguist-vendored
work/pristine/**                 linguist-vendored

